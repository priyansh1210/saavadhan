# Copy this file to .env and fill in the values.

# From https://app.gnani.ai/voice/ -> API keys
GNANI_API_KEY=

# Evon on the GPU box (llama.cpp server). Leave empty to run with the instant rule check only.
# Example: https://something.trycloudflare.com  (no trailing /v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=evon

# Optional tuning
STT_MODEL=prisma-v3.0
STT_LANGS=hi-IN,en-IN
STT_FORMAT=codemix
TTS_MODEL=timbre-v3.0
TTS_VOICE=Tarika
WARN_THRESHOLD=70
